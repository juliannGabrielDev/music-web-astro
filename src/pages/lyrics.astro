---
import Layout from '@/layouts/Layout.astro';
import helloCover from '@/assets/lyrics/hello.jpg';
import stressedCover from '@/assets/lyrics/stressed-out.jpg';
import rollingCover from '@/assets/lyrics/rolling-in-the-deep.jpg';
import heathensCover from '@/assets/lyrics/heathens.jpg';

const defaultSongsServer = [
    { artistName: "Adele", trackName: "Hello", artworkUrl100: helloCover },
    { artistName: "Twenty One Pilots", trackName: "Stressed Out", artworkUrl100: stressedCover },
    { artistName: "Adele", trackName: "Rolling in the Deep", artworkUrl100: rollingCover },
    { artistName: "Twenty One Pilots", trackName: "Heathens", artworkUrl100: heathensCover }
];

const localCoverMapServer = {
    "adele-hello": helloCover,
    "twenty one pilots-stressed out": stressedCover,
    "adele-rolling in the deep": rollingCover,
    "twenty one pilots-heathens": heathensCover
};
---

<Layout>
    <main class="h-screen w-full overflow-y-scroll snap-y snap-mandatory bg-zinc-950 hide-scrollbar smooth-scroll relative" id="mainContainer">
        
        <!-- Full Lyrics View (Hidden by default) -->
        <section id="fullLyricsView" class="fixed inset-0 z-[200] bg-zinc-950 flex flex-col hidden overflow-y-auto custom-scrollbar transform transition-transform duration-500 translate-y-full">
            <div class="sticky top-0 left-0 w-full bg-zinc-900/80 backdrop-blur-md border-b border-white/10 p-4 md:p-6 flex items-center justify-between z-10">
                <button id="closeLyricsBtn" class="flex items-center gap-2 text-zinc-400 hover:text-white transition-colors group">
                    <svg class="w-6 h-6 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    <span class="uppercase tracking-widest text-xs font-bold">Volver al buscador</span>
                </button>
            </div>
            
            <div class="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto p-6 md:p-12 gap-12">
                <!-- Song Info -->
                <div class="md:w-1/3 flex flex-col items-center md:items-start text-center md:text-left md:sticky md:top-32 h-fit">
                    <img id="viewCover" src="" alt="Album Cover" class="w-48 h-48 md:w-full md:max-w-sm rounded-2xl shadow-2xl mb-6 object-cover aspect-square border border-white/10" />
                    <span id="viewArtist" class="text-sm font-bold tracking-[0.2em] uppercase text-purple-400 mb-2 block"></span>
                    <h2 id="viewTitle" class="text-4xl md:text-5xl font-serif italic text-white mb-6"></h2>
                </div>
                
                <!-- Lyrics Content -->
                <div class="md:w-2/3 flex flex-col relative min-h-[50vh]">
                    <div id="lyricsLoading" class="absolute inset-0 flex flex-col items-center justify-center text-zinc-500">
                        <svg class="w-10 h-10 animate-spin mb-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Buscando letra...</span>
                    </div>
                    
                    <div id="lyricsError" class="absolute inset-0 flex-col items-center justify-center text-zinc-500 hidden text-center">
                        <svg class="w-16 h-16 mb-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <h3 class="text-xl text-white mb-2">Letra no encontrada</h3>
                        <p class="text-sm">No pudimos encontrar la letra de esta canción en la base de datos.</p>
                    </div>

                    <p id="viewLyricsText" class="text-zinc-300 text-lg md:text-xl font-light leading-loose whitespace-pre-line hidden pb-20"></p>
                </div>
            </div>
        </section>

        <!-- Hero Search Section -->
        <section class="relative min-h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden py-24">
            <!-- Background Glows -->
            <div class="absolute inset-0 z-0 pointer-events-none">
                <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-purple-900/20 blur-[120px] rounded-full mix-blend-screen"></div>
                <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-amber-900/20 blur-[120px] rounded-full mix-blend-screen"></div>
            </div>

            <div class="relative z-10 flex flex-col items-center gap-8 w-full max-w-4xl px-6 animate-fade-in-up">
                <h1 class="text-6xl md:text-8xl font-display text-white text-center tracking-tighter uppercase drop-shadow-xl">
                    Buscador de Letras
                </h1>
                <p class="text-zinc-400 text-lg md:text-xl font-light text-center max-w-2xl">
                    Busca cualquier canción en nuestra base de datos mundial y lee la letra completa directamente en la página.
                </p>

                <div class="relative w-full mt-8 group">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-6 pointer-events-none">
                        <svg class="w-6 h-6 text-zinc-400 group-focus-within:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input 
                        type="text" 
                        id="searchInput"
                        placeholder="Busca por canción o artista (ej. Adele Hello)..." 
                        class="w-full bg-white/5 border border-white/10 text-white text-lg rounded-full focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500 block pl-16 pr-6 py-5 backdrop-blur-md transition-all duration-300 placeholder-zinc-500 shadow-2xl hover:bg-white/10"
                    />
                    
                    <!-- Search Loader -->
                    <div id="searchLoader" class="absolute inset-y-0 right-0 flex items-center pr-6 hidden">
                        <svg class="w-5 h-5 text-purple-400 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </div>
                </div>

            </div>

            <!-- Real Results Grid -->
            <div id="resultsContainer" class="w-full max-w-7xl mt-16 px-6 relative z-10 transition-opacity duration-500">
                <div id="resultsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <!-- Default Suggestions -->
                </div>

                <div id="noResults" class="hidden flex-col items-center justify-center py-20 text-center">
                    <svg class="w-16 h-16 text-zinc-600 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <h3 class="text-xl font-bold text-white mb-2">No se encontraron canciones</h3>
                    <p class="text-zinc-400">Intenta buscar con otros términos.</p>
                </div>
            </div>
        </section>

    </main>

    <script define:vars={{ defaultSongsServer, localCoverMapServer }}>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const searchLoader = document.getElementById('searchLoader');
            const resultsGrid = document.getElementById('resultsGrid');
            const noResults = document.getElementById('noResults');
            
            // Full Lyrics View Elements
            const fullLyricsView = document.getElementById('fullLyricsView');
            const closeLyricsBtn = document.getElementById('closeLyricsBtn');
            const viewCover = document.getElementById('viewCover');
            const viewArtist = document.getElementById('viewArtist');
            const viewTitle = document.getElementById('viewTitle');
            const viewLyricsText = document.getElementById('viewLyricsText');
            const lyricsLoading = document.getElementById('lyricsLoading');
            const lyricsError = document.getElementById('lyricsError');

            let searchTimeout;

            // Default suggestions (from server-side imports)
            const defaultSongs = defaultSongsServer;
            // Local covers mapping injected from server
            const localCovers = localCoverMapServer;

            function renderCards(songs) {
                if (!resultsGrid) return;
                resultsGrid.innerHTML = '';

                if (songs.length === 0) {
                    if(noResults) noResults.style.display = 'flex';
                    return;
                }
                
                if(noResults) noResults.style.display = 'none';

                songs.forEach((song, index) => {
                    const key = `${(song.artistName||'').toLowerCase()}-${(song.trackName||'').toLowerCase()}`;
                    let imgUrl = '';
                    if (localCovers && localCovers[key]) {
                        imgUrl = localCovers[key].src || localCovers[key];
                    } else if (song.artworkUrl100) {
                        imgUrl = typeof song.artworkUrl100 === 'string' ? song.artworkUrl100.replace('100x100bb', '300x300bb') : song.artworkUrl100.src;
                    }
                    
                    const card = document.createElement('div');
                    card.className = 'song-card bg-black/40 backdrop-blur-md border border-white/10 rounded-3xl p-6 flex flex-col items-center text-center cursor-pointer hover:bg-white/5 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)] group';
                    card.style.animation = `fade-in-up 0.5s ease-out ${index * 0.05}s forwards`;
                    card.style.opacity = '0';
                    
                    card.innerHTML = `
                        <div class="relative w-full aspect-square rounded-2xl overflow-hidden mb-4 shadow-lg ring-1 ring-white/10">
                            <img src="${imgUrl}" alt="${song.trackName}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                <span class="bg-purple-600/80 text-white text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full backdrop-blur-md">Ver Letra</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold tracking-[0.2em] uppercase text-purple-400 mb-1 line-clamp-1 w-full">${song.artistName}</span>
                        <h3 class="text-xl font-serif italic text-white group-hover:text-purple-300 transition-colors line-clamp-2 w-full">${song.trackName}</h3>
                    `;
                    
                    card.addEventListener('click', () => openFullLyrics(song.artistName, song.trackName, imgUrl));
                    resultsGrid.appendChild(card);
                });
            }

            async function performSearch(query) {
                if (!query) {
                    renderCards(defaultSongs);
                    return;
                }

                if (searchLoader) searchLoader.classList.remove('hidden');

                try {
                    // Use iTunes API for reliable song searching and beautiful covers
                    const res = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(query)}&entity=song&limit=12`);
                    const data = await res.json();
                    
                    // Filter out duplicates (iTunes often returns multiple versions of the same song)
                    const uniqueSongs = [];
                    const seen = new Set();
                    for(const song of data.results) {
                        const key = `${song.artistName.toLowerCase()}-${song.trackName.toLowerCase()}`;
                        if(!seen.has(key)) {
                            seen.add(key);
                            uniqueSongs.push(song);
                        }
                    }
                    
                    renderCards(uniqueSongs);
                } catch (error) {
                    console.error('Search error:', error);
                    renderCards([]); // Show no results on error
                } finally {
                    if (searchLoader) searchLoader.classList.add('hidden');
                }
            }

            // Real-time search with debounce
            searchInput?.addEventListener('input', (e) => {
                clearTimeout(searchTimeout);
                const query = e.target.value.trim();
                
                searchTimeout = setTimeout(() => {
                    performSearch(query);
                }, 500);
            });

            // Lyrics fetching and display
            async function openFullLyrics(artist, title, coverUrl) {
                if(!fullLyricsView || !viewArtist || !viewTitle || !viewCover || !viewLyricsText || !lyricsLoading || !lyricsError) return;
                
                // Set initial data
                viewArtist.textContent = artist;
                viewTitle.textContent = title;
                viewCover.src = coverUrl;
                
                // Reset states
                viewLyricsText.classList.add('hidden');
                viewLyricsText.textContent = '';
                lyricsError.classList.add('hidden');
                lyricsLoading.classList.remove('hidden');
                lyricsLoading.classList.add('flex');
                
                // Show view
                fullLyricsView.classList.remove('hidden');
                // Trigger reflow
                fullLyricsView.offsetHeight;
                fullLyricsView.classList.remove('translate-y-full');
                document.body.style.overflow = 'hidden'; // Stop background scrolling

                try {
                    // Fetch real lyrics from lyrics.ovh
                    const res = await fetch(`https://api.lyrics.ovh/v1/${encodeURIComponent(artist)}/${encodeURIComponent(title)}`);
                    if(!res.ok) throw new Error('Not found');
                    
                    const data = await res.json();
                    
                    if(data.lyrics) {
                        // Success
                        lyricsLoading.classList.add('hidden');
                        lyricsLoading.classList.remove('flex');
                        
                        // Clean up ovh promotional text if present
                        let cleanLyrics = data.lyrics;
                        if(cleanLyrics.startsWith('Paroles de la chanson')) {
                            cleanLyrics = cleanLyrics.split('\n').slice(1).join('\n');
                        }
                        
                        viewLyricsText.textContent = cleanLyrics;
                        viewLyricsText.classList.remove('hidden');
                    } else {
                        throw new Error('No lyrics returned');
                    }
                } catch (error) {
                    console.error('Lyrics error:', error);
                    lyricsLoading.classList.add('hidden');
                    lyricsLoading.classList.remove('flex');
                    lyricsError.classList.remove('hidden');
                    lyricsError.classList.add('flex');
                }
            }

            closeLyricsBtn?.addEventListener('click', () => {
                if(!fullLyricsView) return;
                
                fullLyricsView.classList.add('translate-y-full');
                document.body.style.overflow = ''; // Restore scrolling
                
                setTimeout(() => {
                    fullLyricsView.classList.add('hidden');
                }, 500); // Wait for transition
            });

            // Initial render
            renderCards(defaultSongs);
        });
    </script>
</Layout>

<style>
    @reference "../global.css";

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    
    .custom-scrollbar::-webkit-scrollbar {
        width: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.4);
    }

    @keyframes fade-in-up {
        0% {
            opacity: 0;
            transform: translateY(40px);
            filter: blur(10px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    .animate-fade-in-up {
        animation: fade-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
