---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';

// Hero
import bgHero from '@/assets/adele/bg.jpg';
import adeleLogo from '@/assets/adele/adele-logo.png';

// Carousel 1
import gallery1 from '@/assets/adele/carousel/gallery-01.jpg';
import gallery2 from '@/assets/adele/carousel/bg_02.jpg';
import gallery3 from '@/assets/adele/carousel/gallery-03.jpg';
import gallery4 from '@/assets/adele/carousel/bg_03.jpg';
import gallery5 from '@/assets/adele/carousel/gallery-111224.jpg';
import gallery6 from '@/assets/adele/carousel/gallery-111224-1.jpg';
import gallery7 from '@/assets/adele/carousel/gallery-111224-2.jpg';

// Albums
import album19 from '@/assets/adele/albums/19.jpg';
import album21 from '@/assets/adele/albums/21.jpg';
import album25 from '@/assets/adele/albums/25.png';
import album30 from '@/assets/adele/albums/30.jpg';

// Music videos
import mvChasing from '@/assets/adele/music-videos/video_chasingp.jpg';
import mvHello from '@/assets/adele/music-videos/video_hello.jpg';
import mvHometown from '@/assets/adele/music-videos/video_hometownglory.jpg';
import mvMakeUFeel from '@/assets/adele/music-videos/video_make-u-feel-my-love.jpg';
import mvRitd from '@/assets/adele/music-videos/video_RITD.jpeg';
import mvSendMyLove from '@/assets/adele/music-videos/video_sendmylove.jpg';
import mvSetFire from '@/assets/adele/music-videos/video_setfire.jpg';
import mvSomeone from '@/assets/adele/music-videos/video_someonelikeyou.jpg';

const galleryImages = [gallery1, gallery2, gallery3, gallery4, gallery5, gallery6, gallery7];

const albums = [
  { img: album19, name: "19", link: "https://open.spotify.com/album/59ULskOkBMij4zL8pS7mi0" },
  { img: album21, name: "21", link: "https://open.spotify.com/album/0Lg1uZvI312TPqxNWShFXL" },
  { img: album25, name: "25", link: "https://open.spotify.com/album/3AvPX1B1HiFROvYjLb5Qwi" },
  { img: album30, name: "30", link: "https://open.spotify.com/album/21jF5jlMtzo94wbxmJ18aa" }
];

const musicVideos = [
  { img: mvChasing, title: "Chasing Pavements", link: "https://www.youtube.com/watch?v=08DjMT-qR9g" },
  { img: mvHello, title: "Hello", link: "https://www.youtube.com/watch?v=YQHsXMglC9A" },
  { img: mvHometown, title: "Hometown Glory", link: "https://www.youtube.com/watch?v=BW9Fzwuf43c" },
  { img: mvMakeUFeel, title: "Make You Feel My Love", link: "https://www.youtube.com/watch?v=0put0_a--Ng" },
  { img: mvRitd, title: "Rolling in the Deep", link: "https://www.youtube.com/watch?v=rYEDA3JcQqw" },
  { img: mvSendMyLove, title: "Send My Love (To Your New Lover)", link: "https://www.youtube.com/watch?v=fk4BbF7B29w" },
  { img: mvSetFire, title: "Set Fire to the Rain", link: "https://www.youtube.com/watch?v=Ri7-vnrJD3k" },
  { img: mvSomeone, title: "Someone Like You", link: "https://www.youtube.com/watch?v=hLQl3WQQoQ0" }
];

---
<Layout>
    <main class="h-screen w-full overflow-y-scroll snap-y snap-mandatory bg-zinc-950 hide-scrollbar smooth-scroll">
        
        <!-- Hero Section -->
        <section id="hero" class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden">
            <Image src={bgHero} alt="Adele Background" class="absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none" />
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-zinc-950/50 to-zinc-950 pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-12">
                <Image src={adeleLogo} alt="Adele" class="w-64 md:w-96 lg:w-[32rem] object-contain drop-shadow-2xl animate-fade-in-up" />
                
                <div class="flex gap-6 mt-8">
                    <a href="#musica" class="px-8 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-300 hover:scale-105 shadow-lg">
                        Música
                    </a>
                    <a href="#videos" class="px-8 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-300 hover:scale-105 shadow-lg">
                        Videos
                    </a>
                </div>
            </div>
            
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
                <span class="text-xs uppercase tracking-widest text-white">Desliza</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>
        </section>

        <!-- Parallax Gallery Section -->
        <section id="gallery" class="relative h-screen w-full snap-start snap-always bg-zinc-950 overflow-hidden flex items-center justify-center">
            <!-- Animated parallax container -->
            <div class="parallax-container w-full h-full flex flex-col justify-center">
                <h2 class="text-4xl md:text-6xl font-display font-black text-white text-center mb-12 tracking-widest uppercase opacity-80">Galería</h2>
                
                <ul class="carousel-horizontal relative z-10 w-full px-8">
                    {galleryImages.map((img, i) => (
                        <li class="carousel-item">
                            <div class="w-64 h-80 md:w-80 md:h-[28rem] rounded-2xl overflow-hidden shadow-2xl">
                                <Image src={img} alt={`Gallery image ${i+1}`} class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" />
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
            
            <!-- Floating particles -->
            <div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"></div>
        </section>

        <!-- Info Section 1: Biography -->
        <section class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex items-center justify-center p-6 md:p-12 overflow-hidden">
            <div class="max-w-4xl w-full z-10 flex flex-col items-center text-center space-y-8 slide-up-content">
                <span class="text-xs font-bold tracking-[0.3em] uppercase text-purple-400">Los Inicios</span>
                <h3 class="text-3xl md:text-5xl font-serif italic text-white font-light leading-tight">
                    "Nacida en Tottenham, Londres, Adele descubrió su pasión por la música desde una edad temprana..."
                </h3>
                <p class="text-zinc-400 text-lg md:text-xl font-light leading-relaxed max-w-2xl">
                    Se graduó de la BRIT School for Performing Arts and Technology en 2006. Poco después, firmó su primer contrato discográfico, marcando el inicio de una de las carreras más influyentes de la música contemporánea, caracterizada por un sonido crudo, honesto y abrumadoramente emocional.
                </p>
            </div>
            <!-- Ambient detail -->
            <div class="absolute right-0 top-1/4 w-[500px] h-[500px] bg-purple-900/10 blur-[120px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Albums Section -->
        <section id="musica" class="relative h-screen w-full snap-start snap-always bg-zinc-900 flex flex-col items-center justify-center p-6 md:p-12 overflow-hidden">
            <h2 class="text-6xl md:text-8xl font-display font-black text-white mb-16 tracking-tighter uppercase drop-shadow-xl z-10 relative">
                Álbumes
                <div class="absolute -inset-x-6 -inset-y-4 bg-white/5 blur-2xl -z-10 rounded-full"></div>
            </h2>
            
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8 max-w-7xl w-full z-10">
                {albums.map((album) => (
                    <div class="group relative aspect-square rounded-3xl overflow-hidden shadow-2xl hover:-translate-y-4 transition-transform duration-500 ring-1 ring-white/10">
                        <Image src={album.img} alt={`Album cover ${album.name}`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center gap-4 backdrop-blur-sm">
                            <a href={album.link} target="_blank" rel="noopener noreferrer" class="px-8 py-3 rounded-full border border-white/50 text-white font-bold tracking-widest uppercase text-xs hover:bg-white hover:text-black transition-colors duration-300">
                                Escuchar
                            </a>
                        </div>
                    </div>
                ))}
            </div>
            <!-- Ambient glows -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-amber-900/10 blur-[150px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Info Section 2: Impact -->
        <section class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex items-center justify-center p-6 md:p-12 overflow-hidden">
            <div class="max-w-4xl w-full z-10 flex flex-col items-center text-center space-y-8 slide-up-content">
                <span class="text-xs font-bold tracking-[0.3em] uppercase text-amber-500">El Legado</span>
                <h3 class="text-3xl md:text-5xl font-serif italic text-white font-light leading-tight">
                    "Una voz que desafía las épocas y redefine el pop soul moderno."
                </h3>
                <p class="text-zinc-400 text-lg md:text-xl font-light leading-relaxed max-w-2xl">
                    Con más de 120 millones de discos vendidos a nivel mundial, Adele es una de las artistas femeninas más exitosas de la historia. Ha sido galardonada con innumerables premios Grammy, Brit Awards y un Óscar por el tema central de la película Skyfall.
                </p>
            </div>
            <!-- Ambient detail -->
            <div class="absolute left-0 bottom-1/4 w-[500px] h-[500px] bg-amber-900/10 blur-[120px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- I Drink Wine Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden">
            <video 
                src="/assets/adele/videos/i-drink-wine.webm" 
                autoplay muted loop playsinline 
                class="absolute inset-0 w-full h-full object-cover scale-105 pointer-events-none"
            ></video>
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">I Drink Wine</h2>
                <a href="https://www.youtube.com/watch?v=jDvYDzFOK9A" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-red-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:border-red-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Oh My God Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden">
            <video 
                src="/assets/adele/videos/omg.mp4" 
                autoplay muted loop playsinline 
                class="absolute inset-0 w-full h-full object-cover scale-105 pointer-events-none"
            ></video>
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">Oh My God</h2>
                <a href="https://www.youtube.com/watch?v=niG3YMU6jFk" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-red-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:border-red-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Easy On Me Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden">
            <video 
                src="/assets/adele/videos/easy-on-me.webm" 
                autoplay muted loop playsinline 
                class="absolute inset-0 w-full h-full object-cover scale-105 pointer-events-none"
            ></video>
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">Easy On Me</h2>
                <a href="https://www.youtube.com/watch?v=U3ASj1L6_sY" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-red-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:border-red-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Final Music Videos Carousel Section -->
        <section id="videos" class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex flex-col items-center justify-center overflow-hidden">
            <h2 class="text-4xl md:text-6xl font-display font-black text-white text-center mb-16 tracking-widest uppercase opacity-90">Otros Videos</h2>
            
            <ul class="carousel-horizontal relative z-10 w-full px-8 pb-12">
                {musicVideos.map((mv) => (
                    <li class="carousel-item">
                        <a href={mv.link} target="_blank" rel="noopener noreferrer" class="relative block w-72 md:w-[28rem] aspect-video rounded-3xl overflow-hidden shadow-2xl group cursor-pointer ring-1 ring-white/10 hover:ring-purple-500/50 transition-all duration-500">
                            <Image src={mv.img} alt={mv.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-colors duration-500 flex flex-col justify-between p-6">
                                <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                    <span class="text-xs tracking-widest text-purple-300 uppercase font-bold">Ver Video</span>
                                </div>
                                <div class="w-16 h-16 rounded-full bg-black/50 backdrop-blur-md flex items-center justify-center self-center group-hover:scale-110 transition-transform duration-300 border border-white/20 group-hover:border-white/50">
                                    <svg class="w-6 h-6 fill-white ml-1" viewBox="0 0 24 24"><path d="M3 22v-20l18 10-18 10z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-white font-bold tracking-wide text-lg md:text-xl drop-shadow-md">{mv.title}</h3>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

    </main>
</Layout>

<style>
    @reference "../global.css";

    .hide-scrollbar {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    html {
        scroll-behavior: smooth;
    }

    .carousel-horizontal {
        display: grid;
        grid-auto-flow: column;
        gap: 2rem;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        scroll-snap-type: x mandatory;
        padding-inline: max(1rem, 50% - 14rem); /* Center align items */
    }
    
    @media (min-width: 768px) {
        .carousel-horizontal {
            padding-inline: max(2rem, 50% - 20rem);
        }
    }

    .carousel-horizontal::-webkit-scrollbar {
        display: none;
    }

    .carousel-item {
        scroll-snap-align: center;
    }

    /* Animations */
    @keyframes fade-in-up {
        0% {
            opacity: 0;
            transform: translateY(40px) scale(0.98);
            filter: blur(10px);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: blur(0);
        }
    }

    .animate-fade-in-up {
        animation: fade-in-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @supports (animation-timeline: view()) {
        .parallax-container {
            animation: auto linear slide-up-parallax both;
            animation-timeline: view();
            animation-range: entry 0% cover 50%;
        }

        @keyframes slide-up-parallax {
            0% {
                opacity: 0;
                transform: translateY(150px) scale(0.95);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .slide-up-content {
            animation: auto linear reveal-content both;
            animation-timeline: view();
            animation-range: entry 10% cover 40%;
        }

        @keyframes reveal-content {
            0% {
                opacity: 0;
                transform: translateY(40px);
                filter: blur(5px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }
    }
</style>
