---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';

// Hero
import bgHero from '@/assets/top/desktopHeaderBg_0.jpg';
import topLogo from '@/assets/top/footerLogoRed.png';

// Carousel / Gallery
import gallery1 from '@/assets/top/carousel/1f0717_dfd5ea7e0b6c428e9ec2ea06bf094c8d~mv2.jpg';
import gallery2 from '@/assets/top/carousel/21P-por-@agustindusserre-DSC_6319-28012025.jpg';
import gallery3 from '@/assets/top/carousel/Twenty-One-Pilots-1170x658.jpg';
import gallery4 from '@/assets/top/carousel/Twenty-One-Pilots-2021.jpg';
import gallery5 from '@/assets/top/carousel/Twenty-one-pilots-foto-critica-2024.jpg';
import gallery6 from '@/assets/top/carousel/img-2025-02-19_09-01-21.jpg';
import gallery7 from '@/assets/top/carousel/twenty-one-pilots-regresan-semana-que-viene-comienza-nuevo-capitulo_69.jpg';

// Video section / fullscreen images
import imgStressedOut from '@/assets/top/Twenty-One-Pilots-Stressed-Out-screenshot-2019-billboard-1500.webp';
import imgJumpsuit from '@/assets/top/twenty_one_pilots_jumpsuit_numero_1_cancion_billboard_2018.jpg';
import imgOvercompensate from '@/assets/top/overcompensate.jpg';
import imgNextSemester from '@/assets/top/next-semester.jpg';
import imgRoutinesInTheNight from '@/assets/top/routines-in-the-night.jpg';

const galleryImages = [gallery1, gallery2, gallery3, gallery4, gallery5, gallery6, gallery7];

const albums = [
  { img: "https://is1-ssl.mzstatic.com/image/thumb/Music211/v4/73/a7/23/73a7230c-19df-02a4-ff4e-53944024f63d/075679957924.jpg/1000x1000bb.jpg", name: "Vessel", link: "https://open.spotify.com/album/2r2r78NE05YjyHyVbVgqFn" },
  { img: "https://is1-ssl.mzstatic.com/image/thumb/Music211/v4/8e/e2/89/8ee28904-0821-610d-5011-a61845f62756/075679926951.jpg/1000x1000bb.jpg", name: "Blurryface", link: "https://open.spotify.com/album/3cQO7jp5S9qLBoIVtbkSM1" },
  { img: "https://is1-ssl.mzstatic.com/image/thumb/Music211/v4/a3/c0/2b/a3c02b76-baa1-e575-dcba-247509200424/075679864789.jpg/1000x1000bb.jpg", name: "Trench", link: "https://open.spotify.com/album/621cXqrTSSJi1WqDMSLmbL" },
  { img: "https://is1-ssl.mzstatic.com/image/thumb/Music211/v4/24/f2/15/24f215e3-52cc-078b-d799-d58d606feddd/075679786210.jpg/1000x1000bb.jpg", name: "Scaled And Icy", link: "https://open.spotify.com/album/0Q5XBpCYFgUWiG9DUWyAmJ" },
  { img: "https://is1-ssl.mzstatic.com/image/thumb/Music122/v4/8b/39/c6/8b39c655-00fd-1b52-52ea-a98de686f3ae/075679659729.jpg/1000x1000bb.jpg", name: "Clancy", link: "https://open.spotify.com/album/1KFWgQTw3EMTQebaaepVBI" }
];

const musicVideos = [
  { img: imgStressedOut, title: "Stressed Out", link: "https://www.youtube.com/watch?v=pXRviuL6vMY" },
  { img: "https://img.youtube.com/vi/UprcpdwuwCg/maxresdefault.jpg", title: "Heathens", link: "https://www.youtube.com/watch?v=UprcpdwuwCg" },
  { img: "https://img.youtube.com/vi/Pw-0pbY9JeU/maxresdefault.jpg", title: "Ride", link: "https://www.youtube.com/watch?v=Pw-0pbY9JeU" },
  { img: "https://img.youtube.com/vi/eJnQBXmZ7Ek/maxresdefault.jpg", title: "Chlorine", link: "https://www.youtube.com/watch?v=eJnQBXmZ7Ek" },
  { img: imgJumpsuit, title: "Jumpsuit", link: "https://youtu.be/UOUBW8bkjQ4?list=RDUOUBW8bkjQ4" },
  { img: imgOvercompensate, title: "Overcompensate", link: "https://youtu.be/53tgVlXBZVg?list=RD53tgVlXBZVg" },
  { img: imgNextSemester, title: "Next Semester", link: "https://youtu.be/a5i-KdUQ47o?list=RDa5i-KdUQ47o" },
  { img: imgRoutinesInTheNight, title: "Routines In The Night", link: "https://youtu.be/AupwoN8QvbU?list=RDAupwoN8QvbU" }
];

---
<Layout>
    <main class="h-screen w-full overflow-y-scroll snap-y snap-mandatory bg-zinc-950 hide-scrollbar smooth-scroll font-sans">
        
        <!-- Hero Section -->
        <section id="hero" class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden">
            <Image src={bgHero} alt="Twenty One Pilots Background" class="absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none" />
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-zinc-950/50 to-zinc-950 pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-12">
                <Image src={topLogo} alt="Twenty One Pilots" class="w-64 md:w-96 lg:w-[32rem] object-contain drop-shadow-2xl animate-fade-in-up" />
                
                <div class="flex flex-col items-center gap-6 mt-8">
                    <div class="flex gap-6">
                        <a href="#musica" class="px-8 py-3 rounded-full bg-white/10 hover:bg-red-600/50 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-300 hover:scale-105 shadow-lg">
                            Música
                        </a>
                        <a href="#videos" class="px-8 py-3 rounded-full bg-white/10 hover:bg-red-600/50 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-300 hover:scale-105 shadow-lg">
                            Videos
                        </a>
                    </div>
                    
                    <div class="flex flex-col items-center gap-3">
                        <button id="musicToggle" class="px-12 py-4 rounded-3xl bg-white text-black hover:bg-zinc-200 tracking-widest uppercase text-base font-black transition-all duration-300 hover:scale-105 shadow-2xl flex items-center gap-3">
                            <svg id="iconPlay" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            <svg id="iconPause" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                            <span>Reproducir Música</span>
                        </button>
                        
                        <!-- Seeker/Progress bar -->
                        <div class="w-64 md:w-80 flex items-center gap-3 text-white/70 text-xs backdrop-blur-sm bg-black/40 px-4 py-2 rounded-full border border-white/10">
                            <span id="currentTime" class="tabular-nums">0:00</span>
                            <input id="musicSeek" type="range" min="0" max="100" value="0" class="w-full accent-white bg-white/20 h-1 rounded-lg appearance-none cursor-pointer hover:bg-white/30 transition-all duration-300" />
                            <span id="durationTime" class="tabular-nums">0:00</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
                <span class="text-xs uppercase tracking-widest text-white">Desliza</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>
        </section>

        <!-- Parallax Gallery Section -->
        <section id="gallery" class="relative h-screen w-full snap-start snap-always bg-zinc-950 overflow-hidden flex items-center justify-center">
            <!-- Animated parallax container -->
            <div class="parallax-container w-full h-full flex flex-col justify-center">
                <h2 class="text-4xl md:text-6xl font-display font-black text-white text-center mb-12 tracking-widest uppercase opacity-80">Galería</h2>
                
                <ul class="carousel-horizontal relative z-10 w-full px-8">
                    {galleryImages.map((img, i) => (
                        <li class="carousel-item">
                            <div class="w-64 h-80 md:w-80 md:h-[28rem] rounded-2xl overflow-hidden shadow-2xl border border-white/10">
                                <Image src={img} alt={`Gallery image ${i+1}`} class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" />
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
            
            <!-- Floating particles -->
            <div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-red-600/20 via-transparent to-transparent"></div>
        </section>

        <!-- Info Section 1: Biography -->
        <section class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex items-center justify-center p-6 md:p-12 overflow-hidden">
            <div class="max-w-4xl w-full z-10 flex flex-col items-center text-center space-y-8 slide-up-content">
                <span class="text-xs font-bold tracking-[0.3em] uppercase text-red-500">Los Inicios</span>
                <h3 class="text-3xl md:text-5xl font-serif italic text-white font-light leading-tight">
                    "Formada en 2009 en Columbus, Ohio, la banda creó su propio universo sonoro y conceptual..."
                </h3>
                <p class="text-zinc-400 text-lg md:text-xl font-light leading-relaxed max-w-2xl">
                    Tyler Joseph y Josh Dun fusionan rock alternativo, hip hop, electropop y reggae en una propuesta única. Desde sus primeros lanzamientos independientes hasta su gran salto a la fama con Blurryface, han construido una comunidad de fans increíblemente leal, conectada por letras profundas y un lore que atraviesa todos sus álbumes.
                </p>
            </div>
            <!-- Ambient detail -->
            <div class="absolute right-0 top-1/4 w-[500px] h-[500px] bg-red-900/10 blur-[120px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Albums Section -->
        <section id="musica" class="relative h-screen w-full snap-start snap-always bg-zinc-900 flex flex-col items-center justify-center p-6 md:p-12 overflow-hidden">
            <h2 class="text-6xl md:text-8xl font-display font-black text-white mb-16 tracking-tighter uppercase drop-shadow-xl z-10 relative">
                Álbumes
                <div class="absolute -inset-x-6 -inset-y-4 bg-red-600/5 blur-2xl -z-10 rounded-full"></div>
            </h2>
            
            <div class="flex flex-wrap justify-center gap-4 md:gap-8 max-w-7xl w-full z-10">
                {albums.map((album) => (
                    <div class="group relative w-32 md:w-56 aspect-square rounded-3xl overflow-hidden shadow-2xl hover:-translate-y-4 transition-transform duration-500 ring-1 ring-white/10">
                        <img src={album.img} alt={`Album cover ${album.name}`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center gap-4 backdrop-blur-sm">
                            <a href={album.link} target="_blank" rel="noopener noreferrer" class="px-6 md:px-8 py-2 md:py-3 rounded-full border border-white/50 text-white font-bold tracking-widest uppercase text-[10px] md:text-xs hover:bg-white hover:text-black transition-colors duration-300">
                                Escuchar
                            </a>
                        </div>
                    </div>
                ))}
            </div>
            <!-- Ambient glows -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-red-900/10 blur-[150px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Info Section 2: Impact -->
        <section class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex items-center justify-center p-6 md:p-12 overflow-hidden">
            <div class="max-w-4xl w-full z-10 flex flex-col items-center text-center space-y-8 slide-up-content">
                <span class="text-xs font-bold tracking-[0.3em] uppercase text-yellow-500">El Legado</span>
                <h3 class="text-3xl md:text-5xl font-serif italic text-white font-light leading-tight">
                    "Definiendo a una generación con himnos sobre la ansiedad y la esperanza."
                </h3>
                <p class="text-zinc-400 text-lg md:text-xl font-light leading-relaxed max-w-2xl">
                    Con éxitos masivos como 'Stressed Out', 'Heathens' y 'Ride', han roto récords de streaming y de permanencia en listas de Billboard. Ganadores del Grammy, Twenty One Pilots continúa evolucionando en cada era (desde Trench hasta Clancy), demostrando que la música puede ser tan catártica como comercialmente exitosa.
                </p>
            </div>
            <!-- Ambient detail -->
            <div class="absolute left-0 bottom-1/4 w-[500px] h-[500px] bg-yellow-900/10 blur-[120px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Achievements Section -->
        <section class="relative h-screen w-full snap-start snap-always bg-zinc-900 flex flex-col items-center justify-center p-6 md:p-12 overflow-hidden">
            <h2 class="text-4xl md:text-6xl font-display font-black text-white text-center mb-12 tracking-widest uppercase opacity-90 z-10">Logros Destacados</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl w-full z-10 px-4 slide-up-content">
                {[
                    { title: "Premio Grammy", desc: "Mejor Presentación de Dúo/Grupo Pop por 'Stressed Out'" },
                    { title: "Disco de Diamante", desc: "La RIAA certificó 'Stressed Out' como disco de diamante" },
                    { title: "Billboard 200 #1", desc: "'Blurryface' lideró la lista de Billboard con récord de ventas" },
                    { title: "Streaming Masivo", desc: "Miles de millones de streams en Spotify y YouTube" }
                ].map((logro) => (
                    <div class="bg-black/40 backdrop-blur-md border border-white/10 rounded-3xl p-8 flex flex-col items-center text-center hover:bg-black/60 transition-colors duration-300 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(220,38,38,0.3)]">
                        <div class="w-16 h-16 rounded-full bg-red-600/20 border border-red-500/50 flex items-center justify-center mb-6">
                            <svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                        </div>
                        <h4 class="text-white font-bold text-xl mb-3 tracking-wide">{logro.title}</h4>
                        <p class="text-zinc-400 text-sm leading-relaxed">{logro.desc}</p>
                    </div>
                ))}
            </div>
            <!-- Ambient detail -->
            <div class="absolute right-0 bottom-0 w-[600px] h-[600px] bg-red-900/10 blur-[150px] rounded-full pointer-events-none z-0 mix-blend-screen"></div>
        </section>

        <!-- Stressed Out Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden bg-black">
            <Image 
                src={imgStressedOut} 
                alt="Stressed Out"
                class="absolute inset-0 w-full h-full object-cover scale-105 opacity-80 pointer-events-none animate-slow-pan"
            />
            <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">Stressed Out</h2>
                <a href="https://www.youtube.com/watch?v=pXRviuL6vMY" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-red-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:border-red-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Jumpsuit Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden bg-black">
            <Image 
                src={imgJumpsuit} 
                alt="Jumpsuit"
                class="absolute inset-0 w-full h-full object-cover scale-105 opacity-80 pointer-events-none animate-slow-pan"
            />
            <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">Jumpsuit</h2>
                <a href="https://youtu.be/UOUBW8bkjQ4?list=RDUOUBW8bkjQ4" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-yellow-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(202,138,4,0.5)] hover:border-yellow-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Overcompensate Video Section -->
        <section class="relative h-screen w-full snap-start snap-always flex flex-col items-center justify-center overflow-hidden bg-black">
            <Image 
                src={imgOvercompensate} 
                alt="Overcompensate"
                class="absolute inset-0 w-full h-full object-cover scale-105 opacity-80 pointer-events-none animate-slow-pan"
            />
            <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-8 text-center slide-up-content">
                <h2 class="text-5xl md:text-8xl font-serif italic text-white drop-shadow-2xl px-4">Overcompensate</h2>
                <a href="https://youtu.be/53tgVlXBZVg?list=RD53tgVlXBZVg" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-8 py-3 rounded-full bg-white/10 hover:bg-red-600 border border-white/20 text-white tracking-widest uppercase text-sm font-bold backdrop-blur-md transition-all duration-500 shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:border-red-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                    <span>Ver en YouTube</span>
                </a>
            </div>
        </section>

        <!-- Final Music Videos Carousel Section -->
        <section id="videos" class="relative h-screen w-full snap-start snap-always bg-zinc-950 flex flex-col items-center justify-center overflow-hidden">
            <h2 class="text-4xl md:text-6xl font-display font-black text-white text-center mb-16 tracking-widest uppercase opacity-90">Otros Videos</h2>
            
            <ul class="carousel-horizontal relative z-10 w-full px-8 pb-12">
                {musicVideos.map((mv) => (
                    <li class="carousel-item">
                        <a href={mv.link} target="_blank" rel="noopener noreferrer" class="relative block w-72 md:w-[28rem] aspect-video rounded-3xl overflow-hidden shadow-2xl group cursor-pointer ring-1 ring-white/10 hover:ring-red-500/50 transition-all duration-500">
                            <img src={typeof mv.img === 'string' ? mv.img : mv.img.src} alt={mv.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-colors duration-500 flex flex-col justify-between p-6">
                                <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                    <span class="text-xs tracking-widest text-red-300 uppercase font-bold">Ver Video</span>
                                </div>
                                <div class="w-16 h-16 rounded-full bg-black/50 backdrop-blur-md flex items-center justify-center self-center group-hover:scale-110 transition-transform duration-300 border border-white/20 group-hover:border-white/50">
                                    <svg class="w-6 h-6 fill-white ml-1" viewBox="0 0 24 24"><path d="M3 22v-20l18 10-18 10z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-white font-bold tracking-wide text-lg md:text-xl drop-shadow-md">{mv.title}</h3>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

    </main>

    <!-- Background Audio -->
    <audio id="bgAudio" loop autoplay>
        <source src="/assets/songs/twenty one pilots： Tear In My Heart [OFFICIAL VIDEO].mp3" type="audio/mpeg" />
    </audio>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const audio = document.getElementById('bgAudio') as HTMLAudioElement;
            const btn = document.getElementById('musicToggle');
            const iconPlay = document.getElementById('iconPlay');
            const iconPause = document.getElementById('iconPause');
            const seekSlider = document.getElementById('musicSeek') as HTMLInputElement;
            const currentTimeLabel = document.getElementById('currentTime');
            const durationTimeLabel = document.getElementById('durationTime');

            // Format seconds to M:SS
            function formatTime(secs: number) {
                if (isNaN(secs)) return '0:00';
                const minutes = Math.floor(secs / 60);
                const seconds = Math.floor(secs % 60);
                return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            }

            function initAudioInfo() {
                if (audio.duration && seekSlider) {
                    seekSlider.max = audio.duration.toString();
                    if (durationTimeLabel) durationTimeLabel.textContent = formatTime(audio.duration);
                }
            }

            if (audio) {
                audio.play().catch(() => {
                    iconPlay?.classList.remove('hidden');
                    iconPause?.classList.add('hidden');
                });

                if (audio.readyState >= 1) {
                    initAudioInfo();
                } else {
                    audio.addEventListener('loadedmetadata', initAudioInfo);
                }

                // Update slider and timer labels on audio playback
                audio.addEventListener('timeupdate', () => {
                    if (!isSeeking && seekSlider) {
                        seekSlider.value = audio.currentTime.toString();
                    }
                    if (currentTimeLabel) currentTimeLabel.textContent = formatTime(audio.currentTime);
                });
            }

            let isSeeking = false;
            if (seekSlider) {
                seekSlider.addEventListener('input', () => {
                    isSeeking = true;
                    if (currentTimeLabel) currentTimeLabel.textContent = formatTime(Number(seekSlider.value));
                });

                seekSlider.addEventListener('change', () => {
                    if (audio) {
                        audio.currentTime = Number(seekSlider.value);
                    }
                    isSeeking = false;
                });
            }

            btn?.addEventListener('click', () => {
                if (audio.paused) {
                    audio.play();
                    iconPlay?.classList.add('hidden');
                    iconPause?.classList.remove('hidden');
                } else {
                    audio.pause();
                    iconPlay?.classList.remove('hidden');
                    iconPause?.classList.add('hidden');
                }
            });
        });
    </script>
</Layout>

